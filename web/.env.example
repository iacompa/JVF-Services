NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public Google workflow links. Leave blank to show accessible call/text/email fallbacks.
NEXT_PUBLIC_GOOGLE_BOOKING_URL=
NEXT_PUBLIC_GOOGLE_FORM_URL=

# Google Business Profile review integration (server-only unless noted)
# The Business Profile Reviews API requires a verified location and approved API access.
GOOGLE_BUSINESS_ACCOUNT_ID=
GOOGLE_BUSINESS_LOCATION_ID=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# Public HTTPS links copied from the verified Google Business Profile.
GOOGLE_REVIEW_URL=
GOOGLE_REVIEWS_URL=
